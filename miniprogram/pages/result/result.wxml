<view class="page">
  <view class="panel result">
    <text class="r-title">{{stars >= 1 ? '通关！' : '差一点，再来一次'}}</text>
    <text class="stars big">{{starsText}}</text>
    <text class="r-score">得分 {{total}}｜金币 +{{coin}}</text>
    <view class="r-cards" wx:if="{{cards.length}}">
      <text class="r-sub">本关收集知识卡片</text>
      <view wx:for="{{cards}}" wx:key="id" wx:for-item="c" class="r-card">
        <text>{{c.id}} {{c.title}}</text>
      </view>
    </view>
    <view class="btns">
      <button class="btn-secondary" bindtap="onRetry">{{stars >= 3 ? '再刷一次' : '重新挑战'}}</button>
      <button class="btn-primary" bindtap="onBackMap">返回地图</button>
    </view>
  </view>
</view>
