.header { display: flex; justify-content: space-between; align-items: center; }
.title { font-weight: bold; font-size: 32rpx; }

.chapter-title {
  display: flex; align-items: center; gap: 12rpx;
  margin: 28rpx 24rpx 4rpx; font-weight: bold;
}
.chapter-badge {
  background: #D4A934; color: #1A2B4A;
  border: 4rpx solid #1A2B4A; border-radius: 8rpx;
  width: 44rpx; height: 44rpx; display: flex;
  align-items: center; justify-content: center; font-size: 26rpx;
  flex-shrink: 0;
}
.chapter-progress { margin-left: auto; font-size: 24rpx; font-weight: normal; color: #6b5b35; }

.level-node { display: flex; justify-content: space-between; align-items: center; min-height: 88rpx; box-sizing: border-box; gap: 16rpx; }
.level-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.level-name { font-weight: bold; line-height: 1.45; overflow-wrap: anywhere; word-break: break-word; }
.level-right { flex-shrink: 0; }
.level-goal { font-size: 26rpx; color: #555; margin-top: 6rpx; line-height: 1.55; overflow-wrap: anywhere; word-break: break-word; }
.level-lock-hint { font-size: 24rpx; color: #B26A00; margin-top: 6rpx; line-height: 1.5; overflow-wrap: anywhere; word-break: break-word; }
.level-right { display: flex; align-items: center; gap: 12rpx; }
.lock { font-size: 26rpx; color: #C62828; }

/* 继续上次学习入口 */
.resume-banner { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; background: #FFF7D6; border-left: 8rpx solid #D4A934; }
.resume-info { display: flex; flex-direction: column; gap: 6rpx; }
.resume-title { font-weight: bold; color: #1A2B4A; }
.resume-sub { font-size: 24rpx; color: #6b5b35; }
.resume-go { font-weight: bold; color: #2E4A7A; }
