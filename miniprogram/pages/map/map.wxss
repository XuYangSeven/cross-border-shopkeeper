.header { display: flex; justify-content: space-between; align-items: center; }
.title { font-weight: bold; font-size: 32rpx; }

.chapter-title {
  display: flex; align-items: center; gap: 12rpx;
  margin: 28rpx 24rpx 4rpx; font-weight: bold;
}
.chapter-badge {
  background: #D4A934; color: #1A2B4A;
  border: 4rpx solid #1A2B4A; border-radius: 8rpx;
  width: 44rpx; height: 44rpx; display: flex;
  align-items: center; justify-content: center; font-size: 26rpx;
}

.level-node { display: flex; justify-content: space-between; align-items: center; }
.level-info { display: flex; flex-direction: column; }
.level-name { font-weight: bold; }
.level-goal { font-size: 24rpx; color: #666; margin-top: 6rpx; }
.level-right { display: flex; align-items: center; gap: 12rpx; }
.lock { font-size: 32rpx; }
