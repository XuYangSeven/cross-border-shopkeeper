<view class="page"><view class="panel"><text class="title">7日经营结算</text><text class="rating">{{settlement.rating}}</text><view class="grid"><text>总曝光 {{settlement.impressions}}</text><text>总点击 {{settlement.clicks}}</text><text>总订单 {{settlement.orders}}</text><text>销售额 ${{settlement.sales}}</text><text>广告花费 ${{settlement.adSpend}}</text><text>CTR {{settlement.ctr}}%</text><text>CVR {{settlement.cvr}}%</text><text>ACOS {{settlement.acos}}%</text><text>ROAS {{settlement.roas}}</text><text>断货 {{settlement.stockoutDays}}天</text><text>期末库存 {{settlement.endingInventory}}</text><text>期末现金 ¥{{settlement.endingCash}}</text><text>估算利润 ${{settlement.profit}}</text></view><view class="task-box"><text class="title">本周经营任务 {{taskSummary.completed}}/{{taskSummary.total}}</text><view wx:for="{{tasks}}" wx:key="id" class="task-row"><text>{{item.title}}：{{item.status}}</text><text>{{item.description}}</text></view><text wx:if="{{taskSummary.allCompleted}}">全部完成，奖励 {{taskSummary.reward.coins}} 金币 / {{taskSummary.reward.exp}} 经验</text></view><text class="sub">结算结果可用于第7章数据复盘。</text><button bindtap="onSave">保存本次结算</button><button bindtap="onBack">返回店铺</button></view></view>