<view class="page">
  <view class="panel">
    <text class="title">订单与客服</text>
    <text class="sub">解决率是「有没有解决问题」，评分是「客户觉得体验如何」。两个指标要分开打压。</text>
    <view class="kpi-grid">
      <view wx:for="{{kpiTiles}}" wx:key="key" class="kpi">
        <text class="kpi-v">{{item.value}}</text>
        <text class="kpi-k">{{item.label}}</text>
        <text wx:if="{{item.deltaText}}" class="kpi-d {{item.tone}}">{{item.deltaText}}</text>
      </view>
    </view>
  </view>

  <view class="panel">
    <view class="points-head">
      <text class="points-label">本周行动点</text>
      <text class="points-value">{{points.remaining}} / {{points.total}}</text>
    </view>
    <view class="points-bar"><view class="points-fill" style="width:{{pointPercent}}%"></view></view>
  </view>

  <view class="panel">
    <text class="title">服务现状</text>
    <view class="stat-list">
      <view class="stat-row"><text class="stat-k">订单解决率（任务线 90%）</text><text class="stat-v {{shop.service.resolutionRate >= 90 ? 'ok' : 'warn'}}">{{shop.service.resolutionRate}}%</text></view>
      <view class="stat-row"><text class="stat-k">及时响应率</text><text class="stat-v {{shop.service.responseRate >= 90 ? 'ok' : 'warn'}}">{{shop.service.responseRate}}%</text></view>
      <view class="stat-row"><text class="stat-k">店铺评分（任务线 4.3）</text><text class="stat-v {{scoreTone === 'ok' ? 'ok' : 'warn'}}">{{shop.service.rating}}</text></view>
      <view class="stat-row"><text class="stat-k">待处理订单</text><text class="stat-v">{{shop.orders.pending}} 单</text></view>
      <view class="stat-row"><text class="stat-k">退款率</text><text class="stat-v {{shop.orders.refundRate > 3 ? 'warn' : 'ok'}}">{{shop.orders.refundRate}}%</text></view>
      <view class="stat-row"><text class="stat-k">已发货 / 已送达</text><text class="stat-v">{{shop.orders.shipped}} / {{shop.orders.delivered}}</text></view>
    </view>
  </view>

  <view class="panel">
    <text class="title">差距诊断</text>
    <view class="note-list">
      <text wx:for="{{gaps}}" wx:key="*this" class="note-line">· {{item}}</text>
    </view>
  </view>

  <view class="panel">
    <text class="title">可执行的客服动作</text>
    <text class="sub">工单是「零成本、有限次」，补偿与培训要花现金，且各有每周次数上限。</text>
    <view class="action-list">
      <view wx:for="{{actions}}" wx:key="id" class="action {{item.available ? '' : 'action-disabled'}}">
        <view class="action-head">
          <text class="action-label">{{item.label}}</text>
          <text class="action-meta">{{item.costText}}</text>
        </view>
        <text class="action-desc">{{item.desc}}</text>
        <view class="action-tags">
          <text class="tag">{{item.pointsText}}</text>
          <text class="tag tag-limit">{{item.limitText}}</text>
          <text wx:if="{{item.gateText}}" class="tag tag-block">{{item.gateText}}</text>
        </view>
        <text class="action-preview">{{item.preview}}</text>
        <button class="btn-primary action-btn" disabled="{{!item.available}}" data-id="{{item.id}}" bindtap="onAct">执行</button>
      </view>
    </view>
  </view>

  <view class="panel bottom-btns">
    <button class="btn-secondary" bindtap="onBack">返回店铺</button>
  </view>
</view>
