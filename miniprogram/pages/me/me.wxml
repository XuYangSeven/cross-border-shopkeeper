<view class="page" bindtap="onPageTap">
  <view class="panel">
    <text class="title">我的档案</text>
    <view class="row"><text>职级</text><text class="text-gold">{{title}}</text></view>
    <view class="row"><text>经验</text><text>{{exp}} EXP</text></view>
    <view class="row"><text>累计星数</text><text class="stars">★ {{stars}}</text></view>
    <view class="row"><text>下一职级</text><text>{{nextTitle}}</text></view>
    <!-- 存档健康告警：只在异常时出现。写入失败必须让用户看见，不能静默丢进度 -->
    <view wx:if="{{saveAlert}}" class="save-alert">
      <text class="save-alert-title">{{saveAlert.title}}</text>
      <text class="save-alert-body">{{saveAlert.body}}</text>
    </view>
  </view>

  <!-- 金币经济：收入与去向都摊开，学生才知道「省着用提示」到底值不值 -->
  <view class="panel">
    <text class="title">金币</text>
    <view class="row"><text>余额</text><text class="text-gold">{{coins}}</text></view>
    <view class="row"><text>零提示连胜</text><text>{{studyStreak ? studyStreak + ' 关' : '未开始'}}</text></view>
    <text class="coin-hint">零提示通关多拿 50% 金币，连胜每关还会递增；用过任何一级提示（含免费的思路）就失去本关加成并中断连胜。金币可在关卡里换提示，也能在「店铺」的经营周任务中赚取。</text>
    <block wx:if="{{coinLedger.length}}">
      <view class="ledger-head"><text>最近收支</text></view>
      <view wx:for="{{coinLedger}}" wx:key="key" wx:for-item="e" class="ledger-row">
        <text class="ledger-label">{{e.label}}</text>
        <text class="ledger-time">{{e.timeText}}</text>
        <text class="ledger-amount {{e.amount > 0 ? 'ledger-in' : 'ledger-out'}}">{{e.sign}}</text>
      </view>
    </block>
    <text wx:else class="coin-hint">还没有金币记录。通关任意一关就会开始积累。</text>
  </view>

  <!-- 云端同步：登录后进度可跨设备；不登录也照常单机，所以这里必须先讲清代价与好处 -->
  <view class="panel">
    <text class="title">云端同步</text>

    <!-- 未配置云服务（开源默认状态）：只讲清单机事实，不放点了必然失败的按钮 -->
    <block wx:if="{{!sync.configured}}">
      <view class="row"><text>同步状态</text><text class="sync-state-idle">未启用</text></view>
      <text class="sync-hint">当前为纯单机模式：学习进度只保存在本机，换手机或重装后不会自动带过去。要启用跨设备同步，按 docs/云服务接入说明.md 配置 miniprogram/config/cloud.local.js 后重启小程序即可。</text>
    </block>

    <block wx:elif="{{!sync.signedIn}}">
      <text class="sync-hint">不登录也能照常学习，进度存在本机。登录后会把进度备份到云端，换手机或重装后接着学。</text>
      <button
        class="btn-primary sync-main"
        loading="{{sync.busy}}"
        disabled="{{sync.busy}}"
        bindtap="onCloudSignIn"
      >微信一键登录</button>
      <text wx:if="{{sync.message}}" class="sync-message">{{sync.message}}</text>
    </block>

    <block wx:else>
      <view class="row"><text>同步状态</text><text class="{{sync.stateClass}}">{{sync.stateText}}</text></view>
      <view class="row"><text>上次同步</text><text>{{sync.lastSyncText}}</text></view>
      <text class="sync-hint">{{sync.detailText}}</text>

      <block wx:if="{{sync.conflict}}">
        <text class="sync-warn">{{sync.message}}</text>
        <button class="btn-primary sync-main" disabled="{{sync.busy}}" bindtap="onCloudUpload">保留本机，覆盖云端</button>
        <button class="btn-secondary sync-btn" disabled="{{sync.busy}}" bindtap="onCloudDownload">保留云端，覆盖本机</button>
      </block>

      <block wx:else>
        <button
          class="btn-primary sync-main"
          loading="{{sync.busy}}"
          disabled="{{sync.busy}}"
          bindtap="onCloudSyncNow"
        >{{sync.buttonText}}</button>
        <text wx:if="{{sync.message}}" class="sync-message">{{sync.message}}</text>
        <button class="btn-secondary sync-btn" disabled="{{sync.busy}}" bindtap="onCloudDownload">用云端进度覆盖本机</button>
      </block>

      <button class="btn-secondary sync-signout" disabled="{{sync.busy}}" bindtap="onCloudSignOut">退出登录</button>
    </block>
  </view>

  <!-- 能力反馈：来自 engine/learning 的证据聚合 -->
  <view class="panel">
    <text class="title">能力评估</text>
    <view class="row"><text>累计能力分</text><text class="text-gold">{{abilityOverall}}（{{abilityLevel}}）</text></view>
    <block wx:if="{{abilityDims.length}}">
      <view wx:for="{{abilityDims}}" wx:key="key" wx:for-item="d" class="dim-line">
        <text class="dim-name">{{d.label}}</text>
        <view class="dim-bar"><view class="dim-fill" style="width: {{d.barWidth}}%"></view></view>
        <text class="dim-score">{{d.score}}</text>
      </view>
      <view class="rule-toggle" bindtap="onToggleRule">
        <text>评分规则 {{ruleOpen ? '▲' : '▼'}}</text>
      </view>
      <text wx:if="{{ruleOpen}}" class="dim-hint">依据：知识 25% + 迁移 35% + 复盘 25% + 效率 15%｜出现合规错误时该维度封顶 60。分数来自每关的答题正确率、迁移题与复述表现。</text>
    </block>
    <text wx:else class="dim-hint">完成第 1 章的关卡后，这里会生成你的能力评估。</text>
  </view>

  <view class="panel">
    <text class="title">学习工具</text>
    <button wx:if="{{hasResume}}" class="btn-primary tool-main" bindtap="onResume">继续上次学习（{{resumeText}}）</button>
    <button class="btn-secondary tool-btn" bindtap="onOpenReview">
      <text>错题与复盘</text>
      <text wx:if="{{mistakeCount}}" class="badge">{{mistakeCount}}</text>
    </button>
    <button class="btn-secondary tool-btn" bindtap="onOpenManual">复习知识卡片</button>
  </view>

  <!-- 音频开关：能不能关掉背景音乐，直接决定「要不要一直开声音」。必须给用户这一票 -->
  <view class="panel">
    <text class="title">设置</text>
    <view class="row setting-row">
      <text class="setting-label">背景音乐</text>
      <switch checked="{{bgmOn}}" bindchange="onToggleBgm" color="#D4A934" />
    </view>
    <view class="row setting-row">
      <text class="setting-label">音效</text>
      <switch checked="{{sfxOn}}" bindchange="onToggleSfx" color="#D4A934" />
    </view>
    <text class="setting-hint">开关只保存在本机，与闯关进度、金币互不影响。若开了开关仍听不到声音，先检查手机是否处于静音模式或媒体音量为 0。</text>
  </view>

  <view class="panel danger-zone">
    <text class="danger-title">危险操作</text>
    <button class="btn-danger" bindtap="onReset">重置存档（不可撤销）</button>
    <text wx:if="{{saveAlert}}" class="dim-hint">如果重置后仍然报保存失败，说明本机存储不可用（常见于存储空间已满），换设备或清理微信缓存后再试。</text>
  </view>
</view>
