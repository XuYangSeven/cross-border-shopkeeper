.title { font-weight: bold; font-size: 32rpx; }
.sub { font-size: 24rpx; color: #888; margin-top: 8rpx; }
.group-title { font-weight: bold; display: block; margin-bottom: 12rpx; }
.card { background: #FFF8E1; border: 3rpx solid #1A2B4A; border-radius: 0; padding: 16rpx; margin: 12rpx 0; display: flex; flex-direction: column; gap: 8rpx; }
.card-lock { color: #AAA; }
.card-id { font-size: 22rpx; color: #999; }
.card-t { font-weight: bold; }
.card-x { font-size: 26rpx; color: #444; line-height: 1.6; }
