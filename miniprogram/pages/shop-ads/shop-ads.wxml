<view class="page">
  <view class="panel">
    <text class="title">广告实操</text>
    <text class="sub">广告买的是「付费点击」，但只有卖掉货才划算。改预算或竞价，看 ACOS 怎么走。</text>
    <view class="kpi-grid">
      <view wx:for="{{kpiTiles}}" wx:key="key" class="kpi">
        <text class="kpi-v">{{item.value}}</text>
        <text class="kpi-k">{{item.label}}</text>
        <text wx:if="{{item.deltaText}}" class="kpi-d {{item.tone}}">{{item.deltaText}}</text>
      </view>
    </view>
  </view>

  <view class="panel">
    <view class="points-head">
      <text class="points-label">本周行动点</text>
      <text class="points-value">{{points.remaining}} / {{points.total}}</text>
    </view>
    <view class="points-bar"><view class="points-fill" style="width:{{pointPercent}}%"></view></view>
  </view>

  <view class="panel">
    <text class="title">广告现状</text>
    <view class="stat-list">
      <view class="stat-row"><text class="stat-k">投放状态</text><text class="stat-v {{shop.ads.enabled ? 'ok' : 'warn'}}">{{shop.ads.enabled ? '投放中' : '未投放'}}</text></view>
      <view class="stat-row"><text class="stat-k">日预算 / 竞价</text><text class="stat-v">${{shop.ads.dailyBudget}} / ${{shop.ads.bid}}</text></view>
      <view class="stat-row"><text class="stat-k">广告结构分（影响付费转化）</text><text class="stat-v">{{shop.ads.structureScore}}</text></view>
      <view class="stat-row"><text class="stat-k">周点击</text><text class="stat-v">{{kpis.paidClicks}}</text></view>
      <view class="stat-row"><text class="stat-k">周广告花费</text><text class="stat-v">${{kpis.adSpend}}</text></view>
      <view class="stat-row"><text class="stat-k">付费订单 / 自然订单</text><text class="stat-v">{{kpis.paidOrders}} / {{kpis.naturalOrders}}</text></view>
      <view class="stat-row"><text class="stat-k">ACOS / ROAS</text><text class="stat-v {{acosTone === 'warn' ? 'warn' : (acosTone === 'ok' ? 'ok' : '')}}">{{kpis.acos}}% / {{kpis.roas}}</text></view>
    </view>
    <text class="action-preview">{{acosHint}}</text>
  </view>

  <view class="panel">
    <text class="title">可执行的调整</text>
    <text class="sub">调预算是「止血」，调结构是「提效」，两者不要混在一起做。</text>
    <view class="action-list">
      <view wx:for="{{actions}}" wx:key="id" class="action {{item.available ? '' : 'action-disabled'}}">
        <view class="action-head">
          <text class="action-label">{{item.label}}</text>
          <text class="action-meta">{{item.costText}}</text>
        </view>
        <text class="action-desc">{{item.desc}}</text>
        <view class="action-tags">
          <text class="tag">{{item.pointsText}}</text>
          <text class="tag tag-limit">{{item.limitText}}</text>
          <text wx:if="{{item.gateText}}" class="tag tag-block">{{item.gateText}}</text>
        </view>
        <text class="action-preview">{{item.preview}}</text>
        <button class="btn-primary action-btn" disabled="{{!item.available}}" data-id="{{item.id}}" bindtap="onAct">执行</button>
      </view>
    </view>
  </view>

  <view class="panel bottom-btns">
    <button class="btn-secondary" bindtap="onBack">返回店铺</button>
  </view>
</view>
