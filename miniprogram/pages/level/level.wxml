<view class="page">
  <!-- 学习容器头部：章节目标 / 步骤进度 / 阶段标签 -->
  <view wx:if="{{level}}" class="learn-header">
    <view class="learn-top">
      <text class="learn-goal">{{goalText}}</text>
      <text class="learn-stage stage-{{stageKind}}">{{stageLabel}}</text>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progressPercent}}%"></view>
    </view>
    <view class="learn-sub">
      <text>第 {{stepNo}} / {{stepTotal}} 步</text>
      <text wx:if="{{resumedText}}" class="resume-tip">{{resumedText}}</text>
      <text wx:if="{{mistakeCount}}" class="mistake-tip">错题 {{mistakeCount}}</text>
    </view>
  </view>

  <!-- 剧情对话 -->
  <block wx:if="{{view.type === 'dialog'}}">
    <view class="dialog panel">
      <text class="speaker">{{view.speaker}}</text>
      <text class="dialog-text">{{view.text}}</text>
      <button class="btn-primary" bindtap="next">继续 ▶</button>
    </view>
  </block>

  <!-- 知识卡片 -->
  <block wx:if="{{view.type === 'card'}}">
    <view class="card-pop panel">
      <text class="card-badge">知识卡片 {{view.card.id}}</text>
      <text class="card-title">{{view.card.title}}</text>
      <text class="card-text">{{view.card.text}}</text>
      <text class="card-interview">面试官会这样问：{{view.card.interview}}</text>
      <button class="btn-primary" bindtap="next">收下卡片</button>
    </view>
  </block>

  <!-- 选择题 -->
  <block wx:if="{{view.type === 'quiz'}}">
    <view class="panel quiz">
      <text class="q">{{view.question}}</text>
      <view wx:for="{{view.options}}" wx:key="key" wx:for-item="opt" wx:for-index="idx"
        class="option {{view.picked === idx ? (opt.correct ? 'right mark-ok' : 'wrong mark-bad') : ''}}"
        data-idx="{{idx}}" bindtap="onPickOption">
        <text>{{opt.key}}. {{opt.text}}</text>
      </view>
      <view wx:if="{{view.picked !== null && view.picked !== undefined}}" class="feedback-box mj-reveal mj-stagger">
        <text class="fb-line mj-stagger-item">你的选择：{{view.options[view.picked].key}}. {{view.options[view.picked].text}}</text>
        <text class="fb-line fb-right mj-stagger-item">正确答案：{{view.correctKey}}｜{{view.explain}}</text>
      </view>
      <button wx:if="{{quizContinue}}" class="btn-primary" bindtap="onQuizContinue">继续 ▶</button>
    </view>
  </block>

  <!-- 后台模块点亮 -->
  <block wx:if="{{view.type === 'moduleTour'}}">
    <view class="panel">
      <text class="q">按顺序点亮后台 6 大模块</text>
      <view class="modules">
        <view wx:for="{{view.modules}}" wx:key="key" wx:for-item="m"
          class="module {{m.lit ? 'lit' : ''}}"
          data-key="{{m.key}}" bindtap="onTapModule">
          <text>{{m.name}}</text>
        </view>
      </view>
      <button wx:if="{{view.done}}" class="btn-primary" bindtap="next">模块已点亮，继续 ▶</button>
    </view>
  </block>

  <!-- 公式拼装 -->
  <block wx:if="{{view.type === 'formulaPuzzle'}}">
    <view class="panel">
      <text class="q">依次点击三个词块，拼出正确公式</text>
      <view class="formula">销售额 = {{view.placed[0] || '❓'}} × {{view.placed[1] || '❓'}} × {{view.placed[2] || '❓'}}</view>
      <view class="slots-pool">
        <view wx:for="{{view.slots}}" wx:key="*this" wx:for-item="s"
          class="slot-chip {{view.placedMap[s] ? 'used' : ''}}"
          data-name="{{s}}" bindtap="onTapFormulaSlot">{{s}}</view>
      </view>
      <button wx:if="{{view.done}}" class="btn-primary" bindtap="next">公式正确，继续 ▶</button>
    </view>
  </block>

  <!-- 通用计算 -->
  <block wx:if="{{view.type === 'calc'}}">
    <view class="panel">
      <text class="q">{{view.scenario}}</text>
      <view wx:for="{{view.blanks}}" wx:key="index" wx:for-item="b" wx:for-index="i" class="blank-row">
        <input class="blank {{b.ok === true ? 'ok' : b.ok === false ? 'bad' : ''}}"
          type="digit" placeholder="填数字" value="{{b.input}}"
          data-idx="{{i}}" bindinput="onCalcInput" />
        <text class="unit">{{b.unit}}</text>
      </view>
      <button wx:if="{{!view.done}}" class="btn-primary" bindtap="onCalcSubmit">提交</button>
      <button wx:else class="btn-primary" bindtap="next">正确！继续 ▶</button>
    </view>
  </block>

  <!-- 诊断 -->
  <block wx:if="{{view.type === 'diagnose'}}">
    <view class="panel">
      <block wx:if="{{view.phase === 'pick'}}">
        <text class="q">勾出 5 个真问题（含 3 个干扰项）</text>
        <view wx:for="{{view.items}}" wx:key="text" wx:for-item="it" wx:for-index="i"
          class="option check {{it.checked ? 'picked' : ''}}" data-idx="{{i}}" bindtap="onToggleCheck">
          <text>{{it.checked ? '☑' : '☐'}} {{it.text}}</text>
        </view>
        <button class="btn-primary" bindtap="onDiagnoseSubmit">提交诊断</button>
      </block>
      <block wx:if="{{view.phase === 'rx'}}">
        <text class="q">开处方：{{view.currentRxItem.text}}</text>
        <view wx:for="{{view.currentRxOptions}}" wx:key="text"
          wx:for-item="rx" wx:for-index="ri" class="option" data-idx="{{ri}}" bindtap="onPickRx">
          <text>{{rx.text}}</text>
        </view>
      </block>
      <block wx:if="{{view.phase === 'done'}}">
        <text class="q">诊断得分：{{view.finalScore}} / 100</text>
        <button class="btn-primary" bindtap="next">查看复盘 ▶</button>
      </block>
    </view>
  </block>

  <!-- 情报卡初筛 -->
  <block wx:if="{{view.type === 'skuFilter'}}">
    <view class="panel">
      <block wx:if="{{!view.done}}">
        <text class="q">逐张判定情报卡（正确率 ≥80% 才通过）</text>
        <view wx:for="{{view.list}}" wx:key="id" wx:for-item="it" wx:for-index="i" class="sku-card">
          <view class="sku-head">
            <text class="sku-name">{{it.nameZh}}</text>
            <text class="sku-price">${{it.priceUSD}}</text>
          </view>
          <view class="sku-data">
            <text>月搜 {{it.monthlySearch >= 10000 ? (it.monthlySearch / 10000) + '万' : it.monthlySearch}}</text>
            <text>前10评论 {{it.top10AvgReviews}}</text>
            <text>{{it.weightKg}}kg / {{it.dimText}}cm</text>
            <text wx:if="{{it.patentRisk}}" class="text-warn">⚠专利标记</text>
            <text wx:if="{{it.hazmat.length}}" class="text-warn">⚠{{it.hazmat}}</text>
            <text wx:if="{{it.seasonality}}" class="text-warn">⚠强季节</text>
          </view>
          <view class="verdict-btns">
            <view class="v-btn in {{it.verdict === 'in' ? 'on' : ''}}" data-idx="{{i}}" data-verdict="in" bindtap="onVerdict">✅ 候选</view>
            <view class="v-btn out {{it.verdict === 'out' ? 'on' : ''}}" data-idx="{{i}}" data-verdict="out" bindtap="onVerdict">❌ 淘汰</view>
          </view>
          <text wx:if="{{it.verdict === 'out' && it.reason}}" class="text-down">理由：{{it.reasonText}}</text>
          <view wx:if="{{it.correct === false}}" class="fb-box fb-bad mj-reveal mj-stagger">
            <text class="mj-stagger-item">判定有误：正确应选「{{it.correctVerdictText}}」</text>
            <text wx:if="{{it.correctReasonText}}" class="mj-stagger-item">理由：{{it.correctReasonText}}</text>
          </view>
          <text wx:if="{{it.correct === true}}" class="fb-ok mj-reveal">判定正确 ✓</text>
        </view>
        <view wx:if="{{view.result && !view.result.passed}}" class="fb-box fb-bad mj-reveal">
          <text>正确率 {{view.result.ok}}/{{view.result.total}}，未达 80%。先看每张卡的正确判定与理由，再重新提交。</text>
        </view>
        <button wx:if="{{!view.result}}" class="btn-primary" bindtap="onSkuFilterSubmit">提交初筛报告</button>
        <block wx:else>
          <button class="btn-primary" bindtap="onSkuFilterRetry">再做一次</button>
        </block>
      </block>
      <block wx:else>
        <text class="text-up">初筛报告提交成功</text>
        <text class="hint">已完成全部情报卡判定，可以进入下一步利润核算。</text>
        <button class="btn-primary" bindtap="next">继续 ▶</button>
      </block>
    </view>
  </block>

  <!-- 利润演示/核算 -->
  <block wx:if="{{view.type === 'profitDemo' || view.type === 'profitCalc'}}">
    <view class="panel">
      <text class="q">{{view.type === 'profitDemo' ? '跟我算：' : '你来算：'}}{{view.sku.nameZh}}（售价 ${{view.sku.priceUSD}}，供货价 ¥{{view.sku.supplyPriceCNY}}，{{view.sku.dimCm[0]}}×{{view.sku.dimCm[1]}}×{{view.sku.dimCm[2]}}cm / {{view.sku.weightKg}}kg）</text>
      <text class="hint">毛利 = 售价 −（采购+头程+仓配+佣金15%+退货5%+汇损1%）｜汇率 6.8｜海运 ¥9/kg（计费重取大）</text>
      <text class="hint fba-guide">仓配规则：计费重 = 实重与体积重（长×宽×高÷6000）取大；{{view.fbaGuide}}</text>
      <view wx:if="{{view.type === 'profitDemo'}}" class="cost-guide">
        <text>计算结果（美元 / 件）</text>
        <text>采购成本：${{view.result.supplyUSD}}</text>
        <text>头程运费：${{view.result.freightUSD}}</text>
        <text>仓配费用：${{view.result.fbaFeeUSD}}（{{view.result.fbaTier}}，计费重 {{view.result.chargeableWeightKg}}kg）</text>
        <text>平台佣金：${{view.result.commissionUSD}}</text>
        <text>退货损耗：${{view.result.returnLossUSD}} + 汇损：${{view.result.fxLossUSD}}</text>
        <text>总成本：${{view.result.costUSD}}｜毛利：${{view.result.profitUSD}}｜毛利率：{{view.result.margin * 100}}%</text>
      </view>
      <view wx:for="{{view.blanks}}" wx:key="label" wx:for-item="b" wx:for-index="i" class="blank-row">
        <text class="b-label">{{b.label}}</text>
        <input class="blank {{b.ok === true ? 'ok' : b.ok === false ? 'bad' : ''}}"
          type="digit" placeholder="0.00" value="{{b.input}}" disabled="{{view.type === 'profitDemo'}}"
          data-idx="{{i}}" bindinput="onProfitInput" />
      </view>
      <button wx:if="{{view.type === 'profitDemo'}}" class="btn-primary" bindtap="next">看懂了，继续 ▶</button>
      <block wx:else>
        <button wx:if="{{!view.done}}" class="btn-primary" bindtap="onProfitSubmit">提交核算</button>
        <view wx:else class="profit-result">
          <text class="text-up">实际毛利率 {{view.result.margin * 100}}%｜毛利 ${{view.result.profitUSD}}/件</text>
          <text class="result-detail">采购 ${{view.result.supplyUSD}}｜头程 ${{view.result.freightUSD}}｜仓配 ${{view.result.fbaFeeUSD}}（{{view.result.fbaTier}}）</text>
          <text class="result-detail">佣金 ${{view.result.commissionUSD}}｜退货 ${{view.result.returnLossUSD}}｜汇损 ${{view.result.fxLossUSD}}｜总成本 ${{view.result.costUSD}}</text>
          <text wx:if="{{view.trap}}" class="text-warn trap">{{view.trapExplain}}</text>
          <button class="btn-primary" bindtap="next">继续 ▶</button>
        </view>
      </block>
    </view>
  </block>

  <!-- 五维打分 -->
  <block wx:if="{{view.type === 'radarScore'}}">
    <view class="panel">
      <text class="q">五维打分（先选商品，再拖分）</text>
      <view class="radar-tabs">
        <view wx:for="{{view.list}}" wx:key="id" wx:for-item="s" wx:for-index="i"
          class="tab {{view.activeIdx === i ? 'on' : ''}}" data-idx="{{i}}" bindtap="onRadarPick">{{s.nameZh}}</view>
      </view>
      <block wx:if="{{view.activeIdx >= 0}}">
        <view wx:for="{{view.rows}}" wx:key="key" wx:for-item="row" class="dim-row">
          <text class="dim-label">{{row.label}}</text>
          <view class="dim-stars">
            <view wx:for="{{row.cells}}" wx:key="*this" wx:for-item="c"
              class="star-btn {{view.list[view.activeIdx].dims[row.key] >= c ? 'on' : ''}}"
              data-dim="{{row.key}}"
              data-val="{{c}}" bindtap="onRadarDim">★</view>
          </view>
        </view>
        <button wx:if="{{!view.submited}}" class="btn-primary" bindtap="onRadarSubmit">提交打分</button>
        <view wx:else class="rx-list">
          <text wx:for="{{view.totalScores}}" wx:key="nameZh" wx:for-item="t">
            {{t.nameZh}}：我 {{t.mine}} vs 专家 {{t.expert}}
          </text>
        </view>
      </block>
    </view>
  </block>

  <!-- 标题拼装 -->
  <block wx:if="{{view.type === 'titlePuzzle'}}">
    <view class="panel">
      <text class="q">按顺序拼出高质量标题</text>
      <text class="listing-preview">{{view.placedText}}</text>
      <view class="slots-pool">
        <view wx:for="{{view.blocks}}" wx:key="id" wx:for-item="b" class="slot-chip {{b.used ? 'used' : ''}}" data-id="{{b.id}}" bindtap="onTitleBlock">{{b.text}}</view>
      </view>
      <button wx:if="{{view.done}}" class="btn-primary" bindtap="next">标题合格，继续 ▶</button>
    </view>
  </block>

  <!-- 关键词埋词 -->
  <block wx:if="{{view.type === 'keywordPlacement'}}">
    <view class="panel">
      <text class="q">点击关键词，再点击对应位置</text>
      <view class="keyword-pool">
        <view wx:for="{{view.keywords}}" wx:key="key" wx:for-item="k" class="slot-chip {{k.placed ? 'used' : ''}} {{keywordSelected === k.key ? 'selected' : ''}}" data-key="{{k.key}}" bindtap="onKeywordPick">{{k.text}}</view>
      </view>
      <view wx:for="{{view.slots}}" wx:key="key" wx:for-item="s" class="keyword-slot" data-slot="{{s.key}}" bindtap="onKeywordPlace">
        <text class="slot-title">{{s.name}}（{{s.items.length}}/{{s.limit}}）</text>
        <text wx:for="{{s.items}}" wx:key="key" wx:for-item="item" class="placed-keyword" data-key="{{item.key}}" bindtap="onKeywordRemove">{{item.text}} ×</text>
      </view>
      <button wx:if="{{!view.done}}" class="btn-primary" bindtap="onKeywordSubmit">提交关键词布局</button>
      <button wx:else class="btn-primary" bindtap="next">关键词合格，继续 ▶</button>
    </view>
  </block>

  <!-- 主图 A/B 测试 -->
  <block wx:if="{{view.type === 'imageABTest'}}">
    <view class="panel">
      <text class="q">{{view.question}}</text>
      <view wx:for="{{view.variants}}" wx:key="id" wx:for-item="v" class="ab-card {{view.selected === v.id ? 'picked' : ''}}" data-id="{{v.id}}" bindtap="onImagePick">
        <text class="ab-title">方案 {{v.id}} · {{v.name}}</text>
        <text>{{v.description}}</text>
        <text>曝光 {{v.exposure}}｜点击 {{v.clicks}}｜CTR {{v.ctr}}%｜转化 {{v.conversion}}%</text>
      </view>
      <button wx:if="{{!view.done}}" class="btn-primary" bindtap="onImageSubmit">提交测试结论</button>
      <button wx:else class="btn-primary" bindtap="next">测试完成，继续 ▶</button>
    </view>
  </block>

  <!-- 上架优化 Boss -->
  <block wx:if="{{view.type === 'listingBoss'}}">
    <view class="panel">
      <text class="q">选择最终上架组合（目标 ≥ {{view.passScore}} 分）</text>
      <text class="boss-score">当前得分：{{view.score}}</text>
      <text class="boss-label">标题</text>
      <view wx:for="{{view.titleOptions}}" wx:key="id" wx:for-item="o" class="option {{view.picks.title === o.id ? 'picked' : ''}}" data-kind="title" data-id="{{o.id}}" bindtap="onBossPick">{{o.text}}</view>
      <text class="boss-label">关键词</text>
      <view wx:for="{{view.keywordOptions}}" wx:key="id" wx:for-item="o" class="option {{view.picks.keyword === o.id ? 'picked' : ''}}" data-kind="keyword" data-id="{{o.id}}" bindtap="onBossPick">{{o.text}}</view>
      <text class="boss-label">主图</text>
      <view wx:for="{{view.imageOptions}}" wx:key="id" wx:for-item="o" class="option {{view.picks.image === o.id ? 'picked' : ''}}" data-kind="image" data-id="{{o.id}}" bindtap="onBossPick">{{o.text}}</view>
      <text class="boss-label">合规检查</text>
      <view wx:for="{{view.complianceOptions}}" wx:key="id" wx:for-item="o" class="option {{view.picks.compliance === o.id ? 'picked' : ''}}" data-kind="compliance" data-id="{{o.id}}" bindtap="onBossPick">{{o.text}}</view>
      <button wx:if="{{!view.done}}" class="btn-primary" bindtap="onBossSubmit">提交 Listing</button>
      <button wx:else class="btn-primary" bindtap="next">Boss 完成，继续 ▶</button>
    </view>
  </block>

  <!-- 第4章广告投放 -->
  <block wx:if="{{view.type === 'adMetricCalc'}}">
    <view class="panel"><text class="q">{{view.scenario}}</text><view wx:for="{{view.blanks}}" wx:key="label" wx:for-item="b" wx:for-index="i" class="blank-row"><text class="b-label">{{b.label}}</text><input class="blank {{b.ok === true ? 'ok' : b.ok === false ? 'bad' : ''}}" type="digit" value="{{b.input}}" data-key="blanks[{{i}}].input" bindinput="onAdInput"/><text>{{b.unit}}</text></view><button wx:if="{{!view.done}}" class="btn-primary" bindtap="onAdMetricSubmit">提交指标</button><button wx:else class="btn-primary" bindtap="next">正确，继续 ▶</button></view>
  </block>
  <block wx:if="{{view.type === 'searchTermSort'}}"><view class="panel"><text class="q">搜索词分类</text><view wx:for="{{view.list}}" wx:key="term" wx:for-item="it" wx:for-index="i" class="sku-card"><text>{{it.term}}</text><view class="verdict-btns"><view class="v-btn {{it.picked === '核心词' ? 'on' : ''}}" data-idx="{{i}}" data-kind="核心词" bindtap="onAdTermPick">核心词</view><view class="v-btn {{it.picked === '长尾词' ? 'on' : ''}}" data-idx="{{i}}" data-kind="长尾词" bindtap="onAdTermPick">长尾词</view><view class="v-btn {{it.picked === '泛词' ? 'on' : ''}}" data-idx="{{i}}" data-kind="泛词" bindtap="onAdTermPick">泛词</view><view class="v-btn {{it.picked === '风险词' ? 'on' : ''}}" data-idx="{{i}}" data-kind="风险词" bindtap="onAdTermPick">风险词</view></view></view><button wx:if="{{!view.done}}" class="btn-primary" bindtap="onAdTermSubmit">提交分类</button><button wx:else class="btn-primary" bindtap="next">分类完成，继续 ▶</button></view></block>
  <block wx:if="{{view.type === 'negativeKeyword'}}"><view class="panel"><text class="q">否定词或保留</text><view wx:for="{{view.list}}" wx:key="term" wx:for-item="it" wx:for-index="i" class="sku-card"><text>{{it.term}}</text><view class="verdict-btns"><view class="v-btn {{it.picked === '否定词' ? 'on' : ''}}" data-idx="{{i}}" data-kind="否定词" bindtap="onNegativePick">否定词</view><view class="v-btn {{it.picked === '保留' ? 'on' : ''}}" data-idx="{{i}}" data-kind="保留" bindtap="onNegativePick">保留</view></view></view><button wx:if="{{!view.done}}" class="btn-primary" bindtap="onNegativeSubmit">提交分类</button><button wx:else class="btn-primary" bindtap="next">分类完成，继续 ▶</button></view></block>
  <block wx:if="{{view.type === 'adPlacement' || view.type === 'launchStrategy'}}"><view class="panel"><text class="q">选择推荐方案</text><view wx:for="{{view.options}}" wx:key="id" wx:for-item="o" class="option {{view.selected === o.id ? 'picked' : ''}}" data-id="{{o.id}}" bindtap="onAdOptionPick">{{o.label}}</view><button wx:if="{{!view.done}}" class="btn-primary" bindtap="onAdOptionSubmit">提交选择</button><button wx:else class="btn-primary" bindtap="next">选择正确，继续 ▶</button></view></block>
  <block wx:if="{{view.type === 'keywordCampaign'}}"><view class="panel"><text class="q">选择有效广告组与匹配方式</text><view wx:for="{{view.groups}}" wx:key="id" wx:for-item="g" wx:for-index="i" class="option {{g.selected ? 'picked' : ''}}" data-kind="groups" data-idx="{{i}}" bindtap="onAdGroupPick">{{g.name}}</view><view wx:for="{{view.matches}}" wx:key="id" wx:for-item="m" wx:for-index="i" class="option {{m.selected ? 'picked' : ''}}" data-kind="matches" data-idx="{{i}}" bindtap="onAdGroupPick">{{m.name}}</view><button wx:if="{{!view.done}}" class="btn-primary" bindtap="onAdGroupSubmit">提交广告组</button><button wx:else class="btn-primary" bindtap="next">配置完成，继续 ▶</button></view></block>
  <block wx:if="{{view.type === 'bidBudgetSim'}}"><view class="panel"><text class="q">预算不超过 $100，输入预算与竞价</text><input class="blank" type="digit" value="{{view.budgetInput}}" data-key="budgetInput" bindinput="onAdInput"/><input class="blank" type="digit" value="{{view.bidInput}}" data-key="bidInput" bindinput="onAdInput"/><button wx:if="{{!view.done}}" class="btn-primary" bindtap="onBidSubmit">计算预估</button><view wx:if="{{view.result}}"><text>点击 {{view.result.clicks}}｜订单 {{view.result.orders}}｜ACOS {{view.result.acos}}</text></view><button wx:if="{{view.done}}" class="btn-primary" bindtap="next">继续 ▶</button></view></block>
  <block wx:if="{{view.type === 'adBoss'}}"><view class="panel"><text class="q">第 {{view.day}} / 7 天：提交今日参数（总预算 $100）</text><input class="blank" type="digit" value="{{view.dayBudget}}" data-key="dayBudget" bindinput="onAdInput"/><input class="blank" type="digit" value="{{view.bidInput}}" data-key="bidInput" bindinput="onAdInput"/><input class="blank" type="digit" value="{{view.ctrInput}}" data-key="ctrInput" bindinput="onAdInput"/><input class="blank" type="digit" value="{{view.cvrInput}}" data-key="cvrInput" bindinput="onAdInput"/><button wx:if="{{!view.done}}" class="btn-primary" bindtap="onAdBossSubmitDay">提交第 {{view.day}} 天</button><text wx:if="{{view.metrics}}">总花费 ${{view.metrics.spend}}｜订单 {{view.metrics.orders}}｜ACOS {{view.metrics.acos}}｜ROAS {{view.metrics.roas}}</text><button wx:if="{{view.done}}" class="btn-primary" bindtap="next">Boss 通关 ▶</button></view></block>

  <!-- 第5章：物流与库存 -->
  <block wx:if="{{view.type === 'transportChoice'}}"><view class="panel"><text class="q">{{view.scenario}}</text><view wx:for="{{view.options}}" wx:key="id" wx:for-item="o" class="option {{view.selected === o.id ? 'picked' : ''}}" data-id="{{o.id}}" bindtap="onTransportPick">{{o.text}}</view><button wx:if="{{!view.done}}" class="btn-primary" bindtap="onTransportSubmit">提交运输方式</button><button wx:else class="btn-primary" bindtap="next">选择正确，继续 ▶</button></view></block>
  <block wx:if="{{view.type === 'freightCalc'}}"><view class="panel"><text class="q">{{view.scenario}}</text><view wx:for="{{view.blanks}}" wx:key="label" wx:for-item="b" wx:for-index="i" class="blank-row"><text class="b-label">{{b.label}}</text><input class="blank {{b.ok === true ? 'ok' : b.ok === false ? 'bad' : ''}}" type="digit" value="{{b.input}}" data-idx="{{i}}" bindinput="onFreightInput"/><text>{{b.unit}}</text></view><button wx:if="{{!view.done}}" class="btn-primary" bindtap="onFreightSubmit">提交成本</button><button wx:else class="btn-primary" bindtap="next">计算正确，继续 ▶</button></view></block>
  <block wx:if="{{view.type === 'reorderCalc'}}"><view class="panel"><text class="q">{{view.scenario}}</text><view wx:for="{{view.fields}}" wx:key="key" wx:for-item="f" wx:for-index="i" class="blank-row"><text class="b-label">{{f.label}}</text><input class="blank {{f.ok === true ? 'ok' : f.ok === false ? 'bad' : ''}}" type="digit" value="{{f.input}}" data-idx="{{i}}" bindinput="onReorderInput"/><text>{{f.unit}}</text></view><button wx:if="{{!view.done}}" class="btn-primary" bindtap="onReorderSubmit">提交补货点</button><button wx:else class="btn-primary" bindtap="next">计算正确，继续 ▶</button></view></block>
  <block wx:if="{{view.type === 'logisticsIncident'}}"><view class="panel"><text class="q">逐项处理物流异常</text><view wx:for="{{view.incidents}}" wx:key="id" wx:for-item="it" wx:for-index="ii" class="sku-card"><text class="boss-label">{{it.name}}：{{it.text}}</text><view wx:for="{{it.options}}" wx:key="id" wx:for-item="o" wx:for-index="oi" class="option {{it.selected === oi ? 'picked' : ''}}" data-incident="{{ii}}" data-option="{{oi}}" bindtap="onIncidentPick">{{o.text}}</view></view><button wx:if="{{!view.done}}" class="btn-primary" bindtap="onIncidentSubmit">提交应对方案</button><button wx:else class="btn-primary" bindtap="next">异常处理完成，继续 ▶</button></view></block>
  <block wx:if="{{view.type === 'inventoryBoss'}}"><view class="panel"><text class="q">30 天库存管理 Boss：选择运输方式并提交方案</text><view wx:for="{{view.options}}" wx:key="id" wx:for-item="o" class="option {{view.selected === o.id ? 'picked' : ''}}" data-id="{{o.id}}" bindtap="onTransportPick">{{o.text}}</view><view wx:for="{{view.bossFields}}" wx:key="key" wx:for-item="f"><view class="blank-row"><text class="b-label">{{f.label}}</text><input class="blank" type="digit" value="{{view.inputs[f.key]}}" data-key="{{f.key}}" bindinput="onBossInput"/></view></view><button wx:if="{{!view.done}}" class="btn-primary" bindtap="onInventoryBossSubmit">提交库存方案</button><block wx:if="{{view.result}}"><text class="hint">期末库存 {{view.result.endingStock}}｜断货 {{view.result.stockoutDays}} 天｜物流成本 ¥{{view.result.logisticsCost}}｜总成本 ¥{{view.result.totalCost}}</text></block><button wx:if="{{view.done}}" class="btn-primary" bindtap="next">Boss 通关，继续 ▶</button></view></block>

  <!-- 第6章：客服与售后 -->
  <block wx:if="{{view.type === 'customerScenario' || view.type === 'customerBoss'}}">
    <view class="panel customer-panel">
      <text class="q">{{view.scenario}}</text>
      <view wx:for="{{view.cases}}" wx:key="id" wx:for-item="c" wx:for-index="ci" class="customer-case">
        <text class="boss-label">{{c.title}}</text>
        <text class="customer-message">客户：{{c.message}}</text>
        <text class="customer-fact">事实：{{c.facts}}</text>
        <text class="customer-policy">规则：{{c.policy}}</text>
        <view wx:for="{{c.options}}" wx:key="id" wx:for-item="o" wx:for-index="oi" class="option {{o.picked ? 'picked' : ''}}" data-case="{{ci}}" data-option="{{oi}}" bindtap="onCustomerPick">{{o.text}}</view>
        <view wx:if="{{c.result}}" class="customer-review">
          <text class="{{c.result.compliant ? 'text-up' : 'text-warn'}}">{{c.result.compliant ? '合规' : '不合规'}}｜{{c.result.timely ? '及时' : '超时'}}｜{{c.result.resolved ? '已解决' : '未解决'}}｜满意度 {{c.result.satisfaction}}</text>
          <text>{{c.result.explanation}}</text>
        </view>
      </view>
      <button wx:if="{{!view.done}}" class="btn-primary" bindtap="onCustomerSubmit">提交客服方案</button>
      <block wx:if="{{view.result}}">
        <text class="hint">质量均分 {{view.result.qualityScore}}｜及时响应率 {{view.result.timelyResponseRate}}｜解决率 {{view.result.resolutionRate}}｜平均满意度 {{view.result.averageSatisfaction}}｜售后支出 {{view.result.costCents}} 分</text>
        <text wx:if="{{view.result.failureReasons}}" class="text-warn">{{view.result.failureReasons}}</text>
      </block>
      <text class="review-prompt">复盘：{{view.reviewPrompt}}</text>
      <button wx:if="{{view.done}}" class="btn-primary" bindtap="next">客服方案完成，继续 ▶</button>
    </view>
  </block>
  <block wx:if="{{view.type === 'serviceMetrics'}}">
    <view class="panel customer-panel">
      <text class="q">{{view.scenario}}</text>
      <text class="metric-stats">{{view.statsText}}</text>
      <view wx:for="{{view.fields}}" wx:key="key" wx:for-item="f" wx:for-index="fi" class="blank-row">
        <view><text class="b-label">{{f.label}}</text><text class="hint">{{f.formula}}</text></view>
        <input class="blank {{f.ok === true ? 'ok' : f.ok === false ? 'bad' : ''}}" type="digit" value="{{f.input}}" data-idx="{{fi}}" bindinput="onMetricInput" placeholder="如 90" />
        <text>{{f.unit}}</text>
      </view>
      <button wx:if="{{!view.done}}" class="btn-primary" bindtap="onMetricSubmit">提交指标</button>
      <text wx:if="{{view.result}}" class="hint">及时响应 {{view.result.timelyResponseRate}}｜解决率 {{view.result.resolutionRate}}｜退款率 {{view.result.refundRate}}｜满意度 {{view.result.satisfactionRate}}</text>
      <text class="review-prompt">复盘：{{view.reviewPrompt}}</text>
      <button wx:if="{{view.done}}" class="btn-primary" bindtap="next">指标完成，继续 ▶</button>
    </view>
  </block>

  <!-- 第7章：数据分析与运营复盘 -->
  <block wx:if="{{view.type === 'metricIdentify'}}">
    <view class="panel analytics-panel"><text class="q">{{view.scenario}}</text>
      <view wx:for="{{view.items}}" wx:key="id" wx:for-item="it" wx:for-index="ii" class="analytics-item"><text class="boss-label">{{it.text}}</text>
        <view wx:for="{{it.options}}" wx:key="*this" wx:for-item="op" class="option {{it.selected === op ? 'picked' : ''}}" data-item="{{ii}}" data-option="{{op}}" bindtap="onAnalyticsPick">{{op}}</view>
        <text wx:if="{{it.result !== null}}" class="{{it.result ? 'text-up' : 'text-warn'}}">{{it.result ? '归类正确' : '需要调整'}}</text>
      </view>
      <button wx:if="{{!view.done}}" class="btn-primary" bindtap="onAnalyticsSubmit">提交归类</button><text wx:if="{{view.result}}" class="hint">正确 {{view.result.validCount}}/{{view.result.total}}</text><text class="review-prompt">复盘：{{view.reviewPrompt}}</text><button wx:if="{{view.done}}" class="btn-primary" bindtap="next">继续 ▶</button>
    </view>
  </block>
  <block wx:if="{{view.type === 'funnelCalc'}}">
    <view class="panel analytics-panel"><text class="q">{{view.scenario}}</text><text class="hint">曝光 {{view.data.impressions}}｜点击 {{view.data.clicks}}｜访客 {{view.data.visitors}}｜加购 {{view.data.carts}}｜订单 {{view.data.orders}}</text>
      <view wx:for="{{view.fields}}" wx:key="key" wx:for-item="f" wx:for-index="fi" class="blank-row"><view><text class="b-label">{{f.label}}</text></view><input class="blank {{f.ok === true ? 'ok' : f.ok === false ? 'bad' : ''}}" type="digit" value="{{f.input}}" data-idx="{{fi}}" bindinput="onAnalyticsInput"/><text>{{f.unit}}</text></view>
      <button wx:if="{{!view.done}}" class="btn-primary" bindtap="onFunnelSubmit">提交漏斗指标</button><text wx:if="{{view.result}}" class="hint">CTR {{view.result.ctr}}%｜CVR {{view.result.conversionRate}}%｜客单价 ${{view.result.averageOrderValue}}｜ACOS {{view.result.acos}}%</text><text class="review-prompt">复盘：{{view.reviewPrompt}}</text><button wx:if="{{view.done}}" class="btn-primary" bindtap="next">继续 ▶</button>
    </view>
  </block>
  <block wx:if="{{view.type === 'diagnoseChoice' || view.type === 'reviewBoss'}}">
    <view class="panel analytics-panel"><text class="q">{{view.scenario}}</text>
      <view wx:for="{{view.items}}" wx:key="id" wx:for-item="it" wx:for-index="ii" class="analytics-item"><text class="boss-label">{{it.title}}</text><text class="hint">当前值 {{it.value}}｜目标 {{it.target}}</text>
        <view wx:for="{{it.options}}" wx:key="id" wx:for-item="op" class="option {{it.selected === op.id ? 'picked' : ''}}" data-item="{{ii}}" data-option="{{op.id}}" bindtap="onAnalyticsPick">{{op.text}}</view>
        <text wx:if="{{it.result}}" class="{{it.result.valid ? 'text-up' : 'text-warn'}}">{{it.result.valid ? '判断正确' : '需要调整'}}：{{it.result.explanation}}</text>
      </view>
      <button wx:if="{{!view.done}}" class="btn-primary" bindtap="onAnalyticsSubmit">提交复盘</button><text wx:if="{{view.result}}" class="hint">有效判断 {{view.result.validCount}}/{{view.result.total}}｜得分 {{view.result.score}}</text><text class="review-prompt">复盘：{{view.reviewPrompt}}</text><button wx:if="{{view.done}}" class="btn-primary" bindtap="next">继续 ▶</button>
    </view>
  </block>

  <!-- 第8章：资金与经营决策 -->
  <block wx:if="{{view.type === 'cashFlowCalc' || view.type === 'financeCalc' || view.type === 'financeBoss'}}">
    <view class="panel finance-panel"><text class="q">{{view.scenario}}</text>
      <view wx:for="{{view.fields}}" wx:key="key" wx:for-item="f" wx:for-index="fi" class="blank-row"><text class="b-label">{{f.label}}</text><input class="blank {{f.ok === true ? 'ok' : f.ok === false ? 'bad' : ''}}" type="digit" value="{{f.input}}" data-idx="{{fi}}" bindinput="onFinanceInput"/><text>{{f.unit}}</text></view>
      <button wx:if="{{!view.done && view.type === 'cashFlowCalc'}}" class="btn-primary" bindtap="onCashFlowSubmit">提交资金盘点</button><button wx:if="{{!view.done && view.type === 'financeCalc'}}" class="btn-primary" bindtap="onFinanceCalcSubmit">提交利润计算</button><button wx:if="{{!view.done && view.type === 'financeBoss'}}" class="btn-primary" bindtap="onFinanceBossSubmit">提交经营方案</button>
      <text wx:if="{{view.result}}" class="hint">总预算/结果：{{view.result.totalBudget || view.result.bookAssets || view.result.breakEvenPrice || ''}}｜{{view.result.failures}}</text><text class="review-prompt">复盘：{{view.reviewPrompt}}</text><button wx:if="{{view.done}}" class="btn-primary" bindtap="next">继续 ▶</button>
    </view>
  </block>
  <block wx:if="{{view.type === 'pricingChoice' || view.type === 'purchaseChoice'}}">
    <view class="panel finance-panel"><text class="q">{{view.scenario}}</text><view wx:for="{{view.options}}" wx:key="id" wx:for-item="o" wx:for-index="oi" class="option {{o.selected ? 'picked' : ''}}" data-idx="{{oi}}" bindtap="onFinanceOptionPick">{{o.text}}</view><button wx:if="{{!view.done && view.type === 'pricingChoice'}}" class="btn-primary" bindtap="onPricingSubmit">提交价格方案</button><button wx:if="{{!view.done && view.type === 'purchaseChoice'}}" class="btn-primary" bindtap="onPurchaseSubmit">提交采购方案</button><text wx:if="{{view.result}}" class="hint">结果：{{view.result.profitUSD || view.result.coverageDays || ''}}｜{{view.result.valid ? '可行' : '需调整'}}</text><text class="review-prompt">复盘：{{view.reviewPrompt}}</text><button wx:if="{{view.done}}" class="btn-primary" bindtap="next">继续 ▶</button></view>
  </block>
  <block wx:if="{{view.type === 'riskChoice'}}">
    <view class="panel finance-panel"><text class="q">{{view.scenario}}</text><view wx:for="{{view.items}}" wx:key="id" wx:for-item="it" wx:for-index="ii" class="analytics-item"><text class="boss-label">{{it.title}}</text><view wx:for="{{it.options}}" wx:key="id" wx:for-item="o" class="option {{it.selected === o.id ? 'picked' : ''}}" data-item="{{ii}}" data-option="{{o.id}}" bindtap="onRiskPick">{{o.text}}</view><text wx:if="{{it.result}}" class="{{it.result.valid ? 'text-up' : 'text-warn'}}">{{it.result.explanation}}</text></view><button wx:if="{{!view.done}}" class="btn-primary" bindtap="onRiskSubmit">提交风险方案</button><text wx:if="{{view.result}}" class="hint">正确处理 {{view.result.validCount}}/{{view.result.total}}</text><text class="review-prompt">复盘：{{view.reviewPrompt}}</text><button wx:if="{{view.done}}" class="btn-primary" bindtap="next">继续 ▶</button></view>
  </block>

  <!-- 供应商谈判 -->
  <block wx:if="{{view.type === 'negotiate'}}">
    <view class="panel">
      <text class="q">选工厂、用筹码、做三项决策</text>
      <view wx:for="{{view.factories}}" wx:key="name" wx:for-item="f" wx:for-index="i"
        class="option {{view.chosen === i ? 'picked' : ''}}" data-idx="{{i}}" bindtap="onPickFactory">
        <text>{{f.name}}｜¥{{f.basePriceCNY}}/件｜质量 {{f.quality}}｜交期 {{f.leadDays}} 天</text>
      </view>
      <view class="chips">
        <view wx:for="{{view.chips}}" wx:key="*this" wx:for-item="c" wx:for-index="i"
          class="slot-chip {{view.usedChipMap[i] ? 'used' : ''}}"
          data-idx="{{i}}" bindtap="onUseChip">{{c}}</view>
      </view>
      <view class="neg-opts">
        <view class="neg-q">打样？</view>
        <view class="v-btn {{view.sample === 1 ? 'on' : ''}}" data-k="sample" data-v="{{1}}" bindtap="onNegotiateOpt">打样 $50</view>
        <view class="v-btn {{view.sample === 0 ? 'on' : ''}}" data-k="sample" data-v="{{0}}" bindtap="onNegotiateOpt">跳过</view>
        <view class="neg-q">首批量？</view>
        <view class="v-btn {{view.qty === 100 ? 'on' : ''}}" data-k="qty" data-v="{{100}}" bindtap="onNegotiateOpt">100 件</view>
        <view class="v-btn {{view.qty === 300 ? 'on' : ''}}" data-k="qty" data-v="{{300}}" bindtap="onNegotiateOpt">300 件</view>
        <view class="v-btn {{view.qty === 500 ? 'on' : ''}}" data-k="qty" data-v="{{500}}" bindtap="onNegotiateOpt">500 件</view>
      </view>
      <button wx:if="{{!view.done}}" class="btn-primary" bindtap="onNegotiateSubmit">下单</button>
      <view wx:else>
        <text class="{{view.good ? 'text-up' : 'text-warn'}}">成交价 ¥{{view.finalPrice}}/件 {{view.good ? '（接近最优解！）' : '（可行但有更优组合）'}}</text>
        <button class="btn-primary" bindtap="next">继续 ▶</button>
      </view>
    </view>
  </block>

  <!-- 迁移题：换数据、换情境 -->
  <block wx:if="{{view.type === 'transfer'}}">
    <view class="panel transfer-panel">
      <text class="stage-tag stage-transfer">迁移应用</text>
      <text class="q">{{view.scenario}}</text>
      <view wx:for="{{view.questions}}" wx:key="id" wx:for-item="q" wx:for-index="qi" class="transfer-q">
        <text class="tq-title">{{qi + 1}}. {{q.question}}</text>
        <block wx:if="{{q.kind === 'number'}}">
          <view class="blank-row">
            <input class="blank {{q.result ? (q.result.correct ? 'ok' : 'bad') : ''}}" type="digit"
              placeholder="填数字" value="{{q.blankInput}}" disabled="{{view.done}}"
              data-q="{{qi}}" bindinput="onTransferInput" />
            <text class="unit">{{q.unit}}</text>
          </view>
        </block>
        <block wx:else>
          <view wx:for="{{q.options}}" wx:key="key" wx:for-item="o" class="option {{q.picked === o.key ? 'picked' : ''}} {{q.result ? (q.result.correct && q.result.correctAnswer === o.key ? 'right mark-ok' : (q.picked === o.key && !q.result.correct ? 'wrong mark-bad' : '')) : ''}}"
            data-q="{{qi}}" data-key="{{o.key}}" bindtap="onTransferPick">
            <text>{{o.key}}. {{o.text}}</text>
          </view>
        </block>
        <view wx:if="{{q.result}}" class="feedback-box mj-reveal mj-stagger">
          <text class="fb-line {{q.result.correct ? 'fb-right' : 'fb-wrong'}} mj-stagger-item">{{q.result.correct ? '✅ 正确' : '❌ 错误'}}</text>
          <text wx:if="{{!q.result.correct}}" class="fb-line mj-stagger-item">你的答案：{{q.result.userAnswer}}</text>
          <text class="fb-line mj-stagger-item">正确答案：{{q.result.correctAnswer}}</text>
          <text class="fb-line fb-explain mj-stagger-item">{{q.result.explain}}</text>
        </view>
      </view>
      <text wx:if="{{view.result}}" class="score-line">{{view.result.passText}}｜通过线 {{view.passRatio}}</text>
      <button wx:if="{{!view.done}}" class="btn-primary" bindtap="onTransferSubmit">提交迁移作答</button>
      <block wx:else>
        <button class="btn-primary" bindtap="next">迁移达标，继续 ▶</button>
      </block>
      <button wx:if="{{!view.done && view.result}}" class="btn-secondary" bindtap="onTransferRetry">重新作答</button>
    </view>
  </block>

  <!-- 结构化复述：结论 / 依据 / 风险 -->
  <block wx:if="{{view.type === 'reflection'}}">
    <view class="panel reflection-panel">
      <text class="stage-tag stage-reflection">结构化复盘</text>
      <text class="q">{{view.prompt}}</text>
      <view wx:for="{{view.fields}}" wx:key="key" wx:for-item="f" wx:for-index="fi" class="reflect-field">
        <text class="rf-label">{{f.label}}</text>
        <textarea class="rf-input {{f.matched === true ? 'ok' : f.matched === false ? 'bad' : ''}}"
          placeholder="{{f.placeholder}}" value="{{f.input}}" disabled="{{view.done}}"
          auto-height maxlength="200" data-f="{{fi}}" bindinput="onReflectionInput" />
        <text wx:if="{{f.matched === true}}" class="rf-ok">✅ 要点达标（命中：{{f.matchedWords}}）</text>
        <text wx:if="{{f.matched === false}}" class="rf-bad">还缺点：命中 {{f.hits}} / 需要 {{f.required}} 个要点</text>
        <text wx:if="{{f.matched === false && view.done === false && view.result}}" class="rf-sample">参考表述：{{f.sample}}</text>
      </view>
      <text wx:if="{{view.result}}" class="score-line">{{view.result.passText}}｜需要覆盖 {{view.passScore}} 段</text>
      <button wx:if="{{!view.done}}" class="btn-primary" bindtap="onReflectionSubmit">提交复盘</button>
      <block wx:else>
        <view class="reflect-summary">
          <text class="rf-ok">复述已达标，你的表达已覆盖决策、依据与风险。</text>
          <text wx:for="{{view.fields}}" wx:key="key" wx:for-item="f" class="rf-sample">参考表述｜{{f.label}}：{{f.sample}}</text>
        </view>
        <button class="btn-primary" bindtap="next">完成本关 ▶</button>
      </block>
      <button wx:if="{{!view.done && view.result}}" class="btn-secondary" bindtap="onReflectionRetry">修改后再提交</button>
    </view>
  </block>

  <!-- ===== 求助坞：所有可判定步骤共用一处，避免在 43 个步骤分支里各写一遍 ===== -->
  <block wx:if="{{view.hint && view.hint.available}}">
    <view class="hint-dock">
      <view class="hint-head" bindtap="onToggleHint">
        <text class="hint-title">💡 卡住了？</text>
        <text class="hint-sub">{{view.hint.used ? '本关已用提示，零提示奖励已失效' : '思路免费，线索与解析需金币'}}</text>
        <text class="hint-arrow">{{view.hint.open ? '▲' : '▼'}}</text>
      </view>
      <view wx:if="{{view.hint.open}}" class="hint-body mj-dock">
        <view wx:for="{{view.hint.tiers}}" wx:key="tier" wx:for-item="t" class="hint-tier tier-{{t.tier}}">
          <view class="hint-tier-head">
            <text class="hint-tier-label">{{t.label}}</text>
            <text class="hint-tier-price">{{t.price === 0 ? '免费' : t.price + ' 金币'}}</text>
          </view>
          <text class="hint-tier-desc">{{t.desc}}</text>
          <text wx:if="{{t.unlocked}}" class="hint-tier-text mj-fade-up">{{t.text}}</text>
          <button wx:elif="{{t.ready}}" class="hint-buy {{view.hint.coins < t.price ? 'hint-buy-off' : ''}}"
            data-tier="{{t.tier}}" bindtap="onBuyHint">
            {{t.price === 0 ? '看思路' : '解锁（' + t.price + ' 金币）'}}
          </button>
          <text wx:else class="hint-none">这一级暂无可用提示</text>
        </view>
        <text class="hint-foot">零提示通关可多拿 50% 金币并累计连胜；用过任何一级提示（含免费的思路）即失去本关加成。金币可在「店铺」完成经营周任务赚取。</text>
      </view>
    </view>
  </block>
</view>
