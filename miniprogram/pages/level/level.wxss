.dialog { display: flex; flex-direction: column; gap: 20rpx; margin-top: 30vh; }
.speaker { font-weight: bold; color: #D4A934; }
.dialog-text { line-height: 1.7; }

.card-pop { display: flex; flex-direction: column; gap: 16rpx; margin-top: 20vh; background: #FFF8E1; }
.card-badge { font-size: 24rpx; color: #9E9E9E; }
.card-title { font-size: 36rpx; font-weight: bold; color: #1A2B4A; }
.card-text { line-height: 1.7; }
.card-interview { font-size: 24rpx; color: #2E4A7A; background: #EDE7F6; padding: 12rpx; border-radius: 8rpx; }

.quiz .q { font-weight: bold; margin-bottom: 20rpx; line-height: 1.6; }
.option { border: 3rpx solid #1A2B4A; border-radius: 8rpx; padding: 18rpx; margin: 14rpx 0; background: #FFF; }
.option.picked { background: #E3F2FD; }
.option.right { background: #E8F5E9; border-color: #4CAF50; }
.option.wrong { background: #FFEBEE; border-color: #E53935; }
.explain { font-size: 24rpx; color: #666; margin-top: 10rpx; }

.modules { display: flex; flex-wrap: wrap; gap: 16rpx; }
.module { width: 200rpx; text-align: center; padding: 24rpx 0; border: 4rpx solid #1A2B4A; border-radius: 8rpx; background: #ECEFF1; }
.module.lit { background: #D4A934; font-weight: bold; }

.formula { font-size: 32rpx; font-weight: bold; text-align: center; margin: 30rpx 0; }
.slots-pool, .chips { display: flex; gap: 16rpx; flex-wrap: wrap; margin-top: 20rpx; }
.slot-chip { border: 3rpx solid #1A2B4A; border-radius: 999rpx; padding: 10rpx 24rpx; background: #FFF; }
.slot-chip.used { opacity: 0.3; }
.slot-chip.selected { border-color: #D4A934; background: #FFF8E1; box-shadow: 0 0 0 4rpx rgba(212, 169, 52, 0.25); }

.blank-row { display: flex; align-items: center; gap: 16rpx; margin: 12rpx 0; }
.blank { border: 3rpx solid #1A2B4A; border-radius: 8rpx; padding: 12rpx; flex: 1; background: #FFF; }
.blank.ok { border-color: #4CAF50; background: #E8F5E9; }
.blank.bad { border-color: #E53935; background: #FFEBEE; }
.unit, .b-label { width: 220rpx; color: #444; font-size: 26rpx; }
.hint { font-size: 22rpx; color: #888; margin: 10rpx 0; line-height: 1.5; }

.sku-card { border: 3rpx solid #1A2B4A; border-radius: 8rpx; padding: 16rpx; margin: 16rpx 0; background: #FFF; }
.sku-head { display: flex; justify-content: space-between; }
.sku-name { font-weight: bold; }
.sku-data { display: flex; flex-wrap: wrap; gap: 14rpx; font-size: 24rpx; color: #555; margin: 10rpx 0; }
.verdict-btns { display: flex; gap: 16rpx; margin-top: 8rpx; }
.v-btn { border: 3rpx solid #1A2B4A; border-radius: 8rpx; padding: 8rpx 20rpx; background: #FFF; font-size: 24rpx; }
.v-btn.in.on { background: #4CAF50; color: #FFF; }
.v-btn.out.on { background: #E53935; color: #FFF; }
.v-btn.on { font-weight: bold; background: #E3F2FD; border-color: #2E4A7A; box-shadow: 0 0 0 3rpx rgba(46, 74, 122, 0.18); }

.profit-result { display: flex; flex-direction: column; gap: 12rpx; }
.cost-guide { display: flex; flex-direction: column; gap: 8rpx; margin: 18rpx 0; padding: 16rpx; border: 2rpx solid #24395f; background: #fffdf4; line-height: 1.6; }
.result-detail { display: block; color: #555; font-size: 24rpx; line-height: 1.6; }
.fba-guide { display: block; color: #6b5b35; background: #fff7d6; padding: 10rpx; border-left: 6rpx solid #d6a72c; }
.trap { font-size: 24rpx; line-height: 1.5; }

.radar-tabs { display: flex; gap: 12rpx; flex-wrap: wrap; margin: 16rpx 0; }
.tab { padding: 8rpx 20rpx; border: 3rpx solid #1A2B4A; border-radius: 8rpx; background: #FFF; }
.tab.on { background: #2E4A7A; color: #FFF; }
.dim-row { display: flex; align-items: center; margin: 10rpx 0; }
.dim-label { width: 100rpx; }
.dim-stars { display: flex; gap: 10rpx; }
.star-btn { color: #CCC; font-size: 36rpx; }
.star-btn.on { color: #D4A934; }
.rx-list { display: flex; flex-direction: column; gap: 8rpx; }

.customer-case { margin-top: 24rpx; padding-top: 20rpx; border-top: 2rpx solid #d8c7a3; }
.customer-message, .customer-fact, .customer-policy, .customer-review, .review-prompt { display: block; margin-top: 10rpx; line-height: 1.6; }
.customer-message { color: #2d4770; }
.customer-fact, .customer-policy, .review-prompt { color: #79684c; font-size: 24rpx; }
.customer-review { padding: 14rpx; background: #fff8df; }
.customer-panel .option { margin-top: 10rpx; }
.metric-stats { display: block; margin: 16rpx 0 22rpx; padding: 16rpx; background: #fff8df; color: #79684c; line-height: 1.65; font-size: 24rpx; }
.analytics-item { margin-top: 22rpx; padding-top: 16rpx; border-top: 2rpx solid #d8c7a3; }
.analytics-panel .option { margin-top: 10rpx; }
.analytics-panel .hint { display: block; line-height: 1.6; }
.finance-panel .hint { display: block; line-height: 1.6; }

.neg-opts { margin: 16rpx 0; display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; }
.neg-q { width: 100%; font-weight: bold; margin-top: 8rpx; }
.listing-preview { display: block; min-height: 72rpx; padding: 18rpx; margin: 18rpx 0; border: 3rpx dashed #D4A934; background: #FFF8E1; line-height: 1.5; }
.keyword-pool { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0 24rpx; }
.keyword-slot { min-height: 72rpx; padding: 14rpx; margin: 14rpx 0; border: 3rpx solid #1A2B4A; border-radius: 8rpx; background: #F8F9FA; }
.placed-keyword { display: inline-block; margin: 6rpx 8rpx 0 0; padding: 6rpx 10rpx; border: 2rpx solid #2E4A7A; border-radius: 6rpx; color: #2E4A7A; }
.slot-title, .boss-label { display: block; font-weight: bold; margin-bottom: 8rpx; }
.ab-card { display: flex; flex-direction: column; gap: 8rpx; padding: 18rpx; margin: 14rpx 0; border: 3rpx solid #1A2B4A; border-radius: 8rpx; background: #FFF; }
.ab-card.picked { border-color: #D4A934; background: #FFF8E1; }
.ab-title { font-weight: bold; color: #2E4A7A; }
.boss-score { display: block; color: #D4A934; font-size: 34rpx; font-weight: bold; margin: 12rpx 0; }
.boss-label { color: #2E4A7A; margin-top: 20rpx; }

/* 广告投放步骤 */
.ad-summary { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0; color: #2E4A7A; }
.ad-day { border-left: 6rpx solid #D4A934; padding: 12rpx 16rpx; margin: 12rpx 0; background: #FFF8E1; }
