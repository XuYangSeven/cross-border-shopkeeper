<view class="page">
  <view class="panel">
    <text class="title">店铺绩效体检</text>
    <text class="sub">这一页只做诊断，不出方案。先看清哪一维拖后腿，再点进对应模块动手。</text>
    <view class="kpi-grid">
      <view wx:for="{{kpiTiles}}" wx:key="key" class="kpi">
        <text class="kpi-v">{{item.value}}</text>
        <text class="kpi-k">{{item.label}}</text>
        <text wx:if="{{item.deltaText}}" class="kpi-d {{item.tone}}">{{item.deltaText}}</text>
      </view>
    </view>
  </view>

  <view class="panel {{hasRedline ? 'redline-panel' : ''}}">
    <text class="title">经营红线</text>
    <block wx:if="{{hasRedline}}">
      <view class="note-list">
        <text wx:for="{{redlines}}" wx:key="*this" class="note-line redline">⚠ {{item}}</text>
      </view>
      <text class="action-preview">触发红线会让能力证据被标注合规问题，评分封顶 60 分。优先把现金转正、断货压到 2 天以内。</text>
    </block>
    <text wx:else class="sub ok-text">未触发经营红线：现金为正，断货天数在 2 天以内。</text>
  </view>

  <view class="panel">
    <text class="title">五维决策评分 · {{decision.score}} 分（{{decision.level}}）</text>
    <text class="sub">{{decision.summary}}</text>
    <view wx:for="{{rows}}" wx:key="key">
      <view class="decision-row" data-key="{{item.module.key}}" bindtap="onGoto">
        <text class="decision-label">{{item.label}}</text>
        <view class="decision-bar"><view class="decision-fill {{item.tone}}" style="width:{{item.barWidth}}%"></view></view>
        <text class="decision-score">{{item.score}}</text>
        <text class="decision-weight">{{item.weightText}}</text>
      </view>
      <text class="decision-advice">{{item.advice}}<text wx:if="{{item.module}}">　点此行去「{{item.module.name}}」处理 ▸</text></text>
    </view>
  </view>

  <view class="panel">
    <text class="title">服务与风险指标</text>
    <view class="stat-list">
      <view wx:for="{{serviceRows}}" wx:key="k" class="stat-row">
        <text class="stat-k">{{item.k}}</text>
        <text class="stat-v {{item.tone}}">{{item.v}}</text>
      </view>
    </view>
  </view>

  <view class="panel">
    <text class="title">剩余行动点</text>
    <text class="sub">还剩 {{points.remaining}} / {{points.total}} 点。行动点在所有模块之间共享。</text>
  </view>

  <view class="panel bottom-btns">
    <button class="btn-secondary" bindtap="onBack">返回店铺</button>
  </view>
</view>
